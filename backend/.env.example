# ---- SmartHire backend configuration ----
# development | production | test   (production enforces a strong JWT secret and PostgreSQL)
APP_ENV=development

# Local: SQLite file. Production: PostgreSQL (postgres://user:pass@host:5432/db?sslmode=require)
DATABASE_URL=sqlite:///./smarthire.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-64-char-hex-string
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Optional regex, e.g. to allow Vercel preview URLs: https://smarthire-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# LLM: mock (no key, deterministic heuristics) | anthropic | openai
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional overrides. Defaults: anthropic -> claude-opus-5, openai -> gpt-4.1-mini
LLM_MODEL=
# Optional for OpenAI-compatible providers
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Create tables (Alembic) and seed data/Input_Data.json on first start if the DB is empty
AUTO_SEED=true
# Optional shared secret for a scheduler calling POST /screening/run-batch (header X-Admin-Token)
ADMIN_API_TOKEN=
